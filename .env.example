# Copy to .env (gitignored) and adjust for your environment.

# Backend zm_api address used by the Vite dev-server proxy for /api requests.
VITE_API_PROXY_TARGET=http://localhost:8080

# Playwright credentials for LIVE e2e runs (no fallback; seeded mode uses e2e-admin)
TEST_USERNAME=
TEST_PASSWORD=

# Seeded e2e (E2E_MODE=seeded) — see e2e/seed/README.md
ZM_API_DIR=../zm_api
E2E_API_URL=http://127.0.0.1:8089
