{
  "name": "zm-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:chromium": "playwright test --project=chromium",
    "i18n:extract": "i18next --config i18next-parser.config.mjs && node scripts/i18n-plurals.mjs",
    "i18n:check": "i18next --config i18next-parser.config.mjs --fail-on-update && node scripts/i18n-plurals.mjs && git diff --quiet -- src/locales/en/translation.json",
    "i18n:seed": "node scripts/i18n-from-zm.mjs",
    "css:logical": "node scripts/codemod-logical-css.mjs",
    "test:coverage": "vitest run --coverage",
    "test:e2e:seeded": "E2E_MODE=seeded playwright test",
    "e2e:seed:up": "bash e2e/seed/up.sh",
    "e2e:seed:reset": "bash e2e/seed/reset.sh",
    "e2e:seed:down": "bash e2e/seed/down.sh",
    "e2e:seed:api": "bash e2e/seed/api.sh"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-router": "^1.157.18",
    "clsx": "^2.1.1",
    "hls.js": "^1.6.15",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.12",
    "tailwindcss": "^4.1.18",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.60.0",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/router-plugin": "^1.157.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.8",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "i18next-parser": "^9.0.2",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.8"
  }
}
