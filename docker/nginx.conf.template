# zm-web nginx server block. Rendered by docker/entrypoint.sh with envsubst;
# only ${ZM_API_URL}, ${ZM_LISTEN_PORT} and ${ZM_CSP_API_SRC} are substituted.
# For a bare-metal install copy this file, replace those three by hand and drop
# it into /etc/nginx/conf.d/ together with proxy.conf and headers.conf.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Content-Security-Policy. Notes:
#  - style-src needs 'unsafe-inline': React sets inline style attributes for
#    dynamic layout (montage grids, zone overlays, progress bars). Scripts do not.
#  - media-src/img-src need blob: (hls.js MediaSource URLs, canvas snapshots)
#    and data: (inline SVG backgrounds).
#  - worker-src blob: lets hls.js run its demuxer in a worker.
#  - WebRTC ICE (STUN/TURN) is not governed by connect-src; browsers gate it
#    with the separate `webrtc` directive, which defaults to allow, so the
#    Google STUN servers in src/streaming/webrtcManager.ts need no entry here.
#  - ${ZM_CSP_API_SRC} is 'self' unless ZM_API_BASE points at another origin.
map $host $zm_csp {
    default "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src ${ZM_CSP_API_SRC} data: blob:; media-src ${ZM_CSP_API_SRC} blob: data:; font-src 'self'; connect-src ${ZM_CSP_API_SRC}; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'";
}

server {
    listen ${ZM_LISTEN_PORT};
    listen [::]:${ZM_LISTEN_PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Event video uploads are not a thing, but monitor/zone edits carry JSON.
    client_max_body_size 16m;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/vnd.apple.mpegurl;

    include /etc/nginx/zm/headers.conf;

    # --- API -----------------------------------------------------------------
    # Live streams: HLS playlists/segments and the WebRTC signaling socket.
    # No buffering so segments and signaling messages reach the browser as
    # soon as zm_api writes them.
    location ^~ /api/v3/live/ {
        include /etc/nginx/zm/proxy.conf;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_pass ${ZM_API_URL};
    }

    location /api/ {
        include /etc/nginx/zm/proxy.conf;
        proxy_pass ${ZM_API_URL};
    }

    # --- Static app ----------------------------------------------------------
    # Hashed bundles: cache forever.
    location /assets/ {
        include /etc/nginx/zm/headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location /fonts/ {
        include /etc/nginx/zm/headers.conf;
        add_header Cache-Control "public, max-age=604800" always;
        try_files $uri =404;
    }

    # Runtime config and the HTML shell must never be served stale.
    location = /config.js {
        include /etc/nginx/zm/headers.conf;
        add_header Cache-Control "no-store" always;
    }

    location = /index.html {
        include /etc/nginx/zm/headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    # SPA fallback: deep links (/events/123) load index.html and the router
    # takes it from there.
    location / {
        try_files $uri /index.html;
    }
}
